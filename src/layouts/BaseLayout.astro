---
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import '@/styles/global.css';
import { media } from '@/data/media';
const social = media.find(asset => asset.id === 'hero-combat')!;
const socialUrl = Astro.site ? new URL(social.src, Astro.site).href : social.src;

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Spirebreak · Build your machine. Survive 30 waves.',
  description = 'Spirebreak is a single-player tower roguelite about building wild weapon combinations, adapting to new threats and finding a new plan every run.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1013" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta property="og:image:alt" content={social.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialUrl} />
    <meta name="twitter:image:alt" content={social.alt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
