---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RoadmapCard from '@/components/RoadmapCard.astro';
import { roadmap, testing } from '@/data/development';
---
<BaseLayout title="Development · Spirebreak" description="What the Spirebreak team is building, testing and measuring right now.">
  <section class="page-hero shell"><span class="eyebrow">DEVELOPMENT</span><h1>What we are proving next.</h1><p>Spirebreak uses engineering evidence to remove technical uncertainty, then human playtests to answer whether the result is actually fun.</p></section>
  <section class="section shell">
    <div class="lane-header"><span>ACTIVE WORK</span><small>Current engineering and design focus</small></div>
    <div class="card-grid two">{roadmap.filter((item) => item.lane === 'now').map((item) => <RoadmapCard {...item} />)}</div>
  </section>
  <section class="section shell">
    <div class="section-heading"><span class="eyebrow">WHAT WE'RE TESTING</span><h2>Three questions matter right now.</h2></div>
    <div class="test-grid">{testing.map((item, index) => <article class="test-item"><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.question}</p></div></article>)}</div>
  </section>
  <section class="section shell methodology"><div><span class="eyebrow">METHOD</span><h2>Measured facts stay separate from feel.</h2></div><div class="method-grid"><article><strong>Engineering</strong><p>Parity, performance, lifecycle and regression claims require reproducible evidence.</p></article><article><strong>Design</strong><p>Automated runs find extremes and regressions. They do not prove that a decision is interesting.</p></article><article><strong>Human</strong><p>Fun, clarity, tension and replay desire remain open until people play at normal speed.</p></article></div></section>
</BaseLayout>
