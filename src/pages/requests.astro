---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatusPill from '@/components/StatusPill.astro';
import { loadPublicIssues, hasLabel } from '@/lib/github';
import { site } from '@/data/site';
const requests = (await loadPublicIssues()).filter((issue) => hasLabel(issue, 'type:feature'));
---
<BaseLayout title="Player Ideas · Spirebreak" description="Share an idea for Spirebreak and see what other players would like to build, fight or improve.">
  <section class="page-hero shell"><h1>Player ideas</h1><p>Suggestions are collected on GitHub. Listed ideas are not confirmed additions.</p><a class="button primary" href={site.featureNew}>Share an idea</a></section>
  <section class="section shell">
    {requests.length > 0 ? <div class="request-grid">{requests.map((issue) => <a class="request-card" href={issue.html_url}><div class="card-meta"><StatusPill text="PLAYER IDEA" tone="cyan" /><span>👍 {issue.reactions?.['+1'] ?? 0}</span></div><h2>{issue.title}</h2><div class="request-labels">{issue.labels.filter((label) => label.name.startsWith('status:') || label.name.startsWith('area:')).map((label) => <span>{label.name.replace(':', ' · ')}</span>)}</div><small>Open idea #{issue.number} ↗</small></a>)}</div> : <div class="empty-state large"><strong>No player ideas are listed yet.</strong></div>}
  </section>
</BaseLayout>
