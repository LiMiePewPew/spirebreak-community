---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowUpRight, ArrowDown, ArrowRight, Play, Pause, X, Crosshair, Layers } from '@lucide/astro';
import { changelog } from '@/data/updates';
import { contentAsOf, availability } from '@/data/release';
import '@/styles/home.css';
const stages = [
  { id: 'early', name: 'Foundation', text: 'A single Autocannon. The starting point for a new machine.', parts: ['Autocannon', 'Starting chassis'], alt: 'A starting Sentinel with a single Autocannon on its suspended arena.' },
  { id: 'mid', name: 'Fortified', text: 'Three weapon families, with armor and shields to keep them firing.', parts: ['Autocannon', 'Heavy Cannon', 'Arc Coil'], alt: 'A fortified Sentinel with Autocannon, Heavy Cannon and Arc Coil mounts.' },
  { id: 'late', name: 'Ascendant', text: 'An expanded chassis carrying six independent copies and Tier III mutations.', parts: ['Six weapon copies', 'Tier III mutations'], alt: 'An Ascendant Sentinel with an expanded chassis and six weapon copies across five visible mounts.' },
];
const bosses = [
  { wave: '10', name: 'Gate Warden', test: 'Interrupt its charged attack.' },
  { wave: '20', name: 'Forge Tyrant', test: 'Reach it, or survive the barrage.' },
  { wave: '30', name: 'Fractured Crown', test: 'Handle reinforcements and the boss.' },
];
const latest = changelog.slice(0, 3);
const formatDate = (date: string) => new Intl.DateTimeFormat('en', {month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'}).format(new Date(`${date}T00:00:00Z`));
---
<BaseLayout title="Spirebreak | Tower Roguelite" description="Build a machine through 30 waves, choose encounter fronts and return for Spire 1–20 and optional Mutators. A single-player tower roguelite in development." home>
  <section class="showcase-hero" aria-labelledby="game-title">
    <div class="hero-copy">
      <span class="section-label">Single-player tower roguelite</span>
      <h1 id="game-title"><span class="sr-only">Spirebreak. </span>Build your tower.<br /><em>Survive 30 waves.</em></h1>
      <p>Your weapons aim and fire. You choose what to buy, what to combine and when to spend your Scrap.</p>
      <div class="hero-actions">
        <button class="button primary" data-watch><Play size={16} fill="currentColor" /> Watch gameplay</button>
        <a class="text-link" href="#evolution">Explore the builds <ArrowDown size={17} /></a>
      </div>
      <a class="hero-status" href="/development"><i aria-hidden="true"></i>{availability.game} <ArrowUpRight size={14} /></a>
    </div>
    <div class="hero-media">
      <picture class="hero-scene"><source type="image/avif" srcset="/media/showcase/combat-960.avif 960w, /media/showcase/combat-1920.avif 1920w" sizes="(max-width: 760px) 150vw, 100vw" /><img src="/media/showcase/combat-1920.webp" alt="An armed Sentinel holds the center of the arena as enemies close in." width="1920" height="1080" fetchpriority="high" /></picture>
      <video class="hero-film" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-hero-video data-src="/media/showcase/combat-loop.mp4"></video>
      <div class="hero-media-caption"><span>Staged in-engine gameplay · Sep 22, 2026</span><button class="icon-button film-toggle" data-film-toggle aria-label="Play background video" title="Play background video" hidden><Play class="play-icon" size={17} /><Pause class="pause-icon" size={17} /></button></div>
    </div>
  </section>

  <section class="evolution-section section shell" id="evolution" aria-labelledby="evolution-title">
    <div class="section-intro"><div><span class="section-label">The Sentinel</span><h2 id="evolution-title">Compare three builds.</h2></div><p>Switch builds. See the hardware change.</p></div>
    <div class="evolution" data-evolution>
      <div class="evolution-controls">
        <div class="evolution-tabs" role="tablist" aria-label="Tower evolution">{stages.map((stage, i) => <button id={`tab-${stage.id}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`stage-${stage.id}`} tabindex={i === 0 ? 0 : -1} data-stage={stage.id}><span aria-hidden="true">0{i + 1}</span>{stage.name}</button>)}</div>
        <label class="arena-toggle"><input type="checkbox" id="full-arena" /> Full arena</label>
      </div>
      <div class="evolution-stage">{stages.map((stage, i) => <div class="stage-panel" id={`stage-${stage.id}`} role="tabpanel" aria-labelledby={`tab-${stage.id}`} hidden={i !== 0} tabindex="0">
        <div class="stage-visual"><picture><source type="image/avif" srcset={`/media/showcase/${stage.id}-960.avif 960w, /media/showcase/${stage.id}-1920.avif 1920w`} sizes="(max-width: 760px) 220vw, 150vw" /><img src={`/media/showcase/${stage.id}-1920.webp`} alt={stage.alt} width="1920" height="1080" loading="lazy" /></picture><span class="view-label" aria-hidden="true"><Crosshair size={14} /><span class="close-label">Detail view</span><span class="wide-label">Full arena</span></span></div>
        <div class="stage-copy"><span class="section-label">Build example / 0{i + 1}</span><h3>{stage.name}</h3><p>{stage.text}</p><ul class="build-parts" aria-label="Shown in this build">{stage.parts.map(part => <li>{part}</li>)}</ul><a class="text-link" href="/game#build">How builds work <ArrowUpRight size={16} /></a></div>
      </div>)}</div>
    </div>
    <div class="build-caption"><p>Staged builds · Sep 22, 2026. Chassis appearance is separate from Spire difficulty.</p><a class="text-link" href="/game#survive">Defense, economy & tradeoffs <ArrowRight size={16} /></a></div>
  </section>

  <section class="boss-section shell" aria-labelledby="boss-title">
    <div class="boss-visual"><picture><source type="image/avif" srcset="/media/showcase/boss-960.avif 960w, /media/showcase/boss-1920.avif 1920w" sizes="(max-width: 760px) 160vw, 100vw" /><img src="/media/showcase/boss-1920.webp" alt="The Sentinel fights a boss at close range while smaller enemies approach." width="1920" height="1080" loading="lazy" /></picture><span>Staged boss encounter · Sep 22, 2026</span></div>
    <div class="boss-copy"><span class="section-label">Put the build to the test</span><h2 id="boss-title">Three bosses.<br />Different answers.</h2>
      <ol class="boss-list">{bosses.map(boss => <li><span class="wave-number"><small>Wave</small>{boss.wave}</span><div><h3>{boss.name}</h3><p>{boss.test}</p></div></li>)}</ol>
      <a class="text-link" href="/game#bosses">Read the encounters <ArrowUpRight size={16} /></a>
    </div>
  </section>

  <section class="return-section shell" aria-labelledby="return-title">
    <div><Layers size={26} aria-hidden="true" /><h2 id="return-title">Choose the next challenge.</h2></div>
    <div class="return-copy"><p>Pick Swarm or Siege fronts after Waves 10 and 20. After your first victory, climb Spire 1–20 or combine up to three Mutators.</p><p class="return-note">Mutator runs keep records, but do not unlock the next Spire.</p><a class="text-link" href="/game#fronts">Explore the run choices <ArrowRight size={17} /></a></div>
  </section>

  <section class="development-section section" id="development" aria-labelledby="development-title"><div class="shell">
    <div class="section-intro"><div><span class="section-label">Development journal</span><h2 id="development-title">From the workshop.</h2></div><a class="text-link" href="/changelog">All updates <ArrowUpRight size={18} /></a></div>
    <div class="home-updates">{latest.map((update, i) => <a class:list={{ 'lead-update': i === 0 }} href={`/changelog/${update.slug}`}><div class="update-meta"><span>{update.kicker}</span><time datetime={update.date}>{formatDate(update.date)}</time></div><h3>{update.title}</h3>{i === 0 && <p>{update.summary}</p>}<span class="read-update">Read update <ArrowUpRight size={17} aria-hidden="true" /></span></a>)}</div>
    <div class="development-bottom"><p>Content reviewed <time datetime={contentAsOf}>{formatDate(contentAsOf)}</time>. Public ranked play is not open.</p><div><a class="text-link" href="/roadmap">Roadmap</a><a class="text-link" href="/development">Playtest & feedback <ArrowRight size={16} /></a></div></div>
  </div></section>

  <dialog class="media-dialog" id="gameplay-dialog" aria-labelledby="film-title"><div class="dialog-top"><h2 id="film-title">Spirebreak / Mini trailer</h2><button class="icon-button" data-close aria-label="Close gameplay video" title="Close"><X size={22} /></button></div><video controls playsinline preload="none" poster="/media/showcase/combat-1920.webp" data-full-video><source src="/media/showcase/mini-trailer.mp4" type="video/mp4" /><a href="/media/showcase/mini-trailer.mp4">Watch gameplay</a></video><p>Staged in-engine footage captured September 22, 2026, with UI hidden. It does not show all later changes. <a href="/changelog">Read the latest updates.</a></p></dialog>
  <script src="../scripts/home.ts"></script>
</BaseLayout>
