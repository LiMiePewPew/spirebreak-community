---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameMedia from '@/components/GameMedia.astro';
import { media } from '@/data/media';
import { site } from '@/data/site';
import { changelog } from '@/data/changelog';
import '@/styles/home.css';
const get = (id: string) => {
  const asset = media.find(item => item.id === id);
  if (!asset) throw new Error(`Missing reviewed media: ${id}`);
  return asset;
};
const gallery = [
  { id: 'gatewarden', label: 'SURVIVE', title: 'Bring your whole machine.', text: 'Bosses put every weapon and defense to the test.' },
  { id: 'heavy-encounter', label: 'ADAPT', title: 'Find an answer to the pressure.', text: 'Heavy targets, support units and split enemies ask different things of your build.' },
  { id: 'artifact-choice', label: '16 ARTIFACTS', title: 'Change the rules.', text: 'Boss rewards can reshape a run instead of simply adding another percentage.' },
  { id: 'build-paths', label: 'BUILD', title: 'Choose a direction. Then evolve it.', text: 'Weapons, defense and synergies turn purchases into a machine with an identity.' },
  { id: 'hall-of-machines', label: 'RETURN', title: 'Every run leaves a machine behind.', text: 'Revisit what you built. Start the next run with a different idea.' },
];
const latest = changelog[0];
---
<BaseLayout title="Spirebreak · Build impossible machines. Survive the tower." description="Build impossible machines. Survive the tower.">
  <section class="game-hero shell" aria-labelledby="game-title">
    <div class="hero-heading">
      <p class="game-hero-kicker">Single-player tower roguelite</p>
      <h1 id="game-title">Build impossible machines.<br /><span>Survive 30 escalating waves.</span></h1>
    </div>
    <figure class="hero-frame">
      <GameMedia asset={get('hero-combat')} eager sizes="(max-width: 820px) calc(100vw - 28px), (max-width: 1220px) 56vw, 660px" />
      <figcaption><span>REAL GAMEPLAY</span><span>A machine under pressure.</span></figcaption>
    </figure>
    <div class="hero-details">
      <p class="hero-copy">Your tower fights automatically. You choose the weapons, defenses and rule-changing Artifacts that make each run your own.</p>
      <div class="hero-actions">
        <a class="button primary" href="#gameplay">See the machine work ↓</a>
        <a class="button secondary" href="/changelog">What's new</a>
      </div>
    </div>
  </section>

  <div class="run-facts shell" aria-label="Current game features">
    <span><strong>7</strong> starter weapons</span><span><strong>16</strong> Artifacts</span>
    <span><strong>30</strong> escalating waves</span><span>Branching evolutions</span>
  </div>

  <section id="gameplay" class="section shell gameplay-gallery" aria-labelledby="gallery-title">
    <div class="section-heading">
      <span class="eyebrow">SEE THE MACHINE WORK</span>
      <h2 id="gallery-title">Every choice changes the run.</h2>
      <p>Spend Scrap. Stack weapons. Adapt before the next threat arrives.</p>
    </div>
    <div class="capture-grid">
      {gallery.map((item, index) => (
        <figure class:list={['capture-card', { 'capture-feature': index === 2 }]}>
          <a class="capture-link" href={get(item.id).src} aria-label={`Open full-size capture: ${get(item.id).caption}`}>
            <GameMedia asset={get(item.id)} sizes={index === 2 ? '(max-width: 820px) calc(100vw - 28px), (max-width: 1220px) 66vw, 775px' : '(max-width: 820px) calc(100vw - 28px), (max-width: 1220px) 48vw, 580px'} />
          </a>
          <figcaption>
            <span class="eyebrow">{item.label}</span><h3>{item.title}</h3><p>{item.text}</p>
            <a class="text-link" href={get(item.id).src}>View full size ↗</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="portrait-section shell" aria-labelledby="portrait-title">
    <figure class="portrait-frame">
      <a href={get('portrait-boss').src} aria-label="Open full-size portrait gameplay">
        <GameMedia asset={get('portrait-boss')} sizes="(max-width: 480px) calc(100vw - 68px), 320px" />
      </a>
      <figcaption>Real portrait gameplay · Current development build</figcaption>
    </figure>
    <div class="portrait-copy">
      <span class="eyebrow">A DIFFERENT VIEW. THE SAME DECISIONS.</span>
      <h2>The machine goes with you.</h2>
      <p>Portrait and desktop layouts keep your build choices close to the action.</p>
      <p class="muted">Mobile device testing is still in progress.</p>
      <a class="text-link" href="/development">See the current playtest status →</a>
    </div>
  </section>

  <section class="section shell development-footer" aria-labelledby="development-title">
    <div class="section-heading split-heading">
      <div><span class="eyebrow">FROM THE WORKSHOP</span><h2 id="development-title">The next machine is taking shape.</h2></div>
      <a class="text-link" href="/changelog">All updates →</a>
    </div>
    <a class="latest-card" href={`/changelog/${latest.slug}`}>
      <time datetime={latest.date}>{latest.date}</time><h3>{latest.title}</h3><p>{latest.summary}</p><span class="text-link">Read the update →</span>
    </a>
    <div class="development-links">
      <a href="/roadmap">What's next →</a><a href="/development">What we're testing →</a>
      <a href="/issues">Known issues →</a><a href="/requests">Community ideas →</a>
    </div>
  </section>

  <section class="community-cta">
    <div class="shell community-grid">
      <div><span class="eyebrow">HELP SHAPE THE NEXT RUN</span><h2>What did your machine teach you?</h2><p>Tell us what worked, what broke and what you want to build next.</p></div>
      <div class="community-actions"><a class="button primary" href={site.bugNew}>Report a bug</a><a class="button secondary" href={site.featureNew}>Request a feature</a></div>
    </div>
  </section>
</BaseLayout>
