---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameMedia from '@/components/GameMedia.astro';
import { media } from '@/data/media';
import { site } from '@/data/site';
import { changelog } from '@/data/changelog';
import '@/styles/home.css';
const get = (id: string) => {
  const asset = media.find(item => item.id === id);
  if (!asset) throw new Error(`Missing reviewed media: ${id}`);
  return asset;
};
const gallery = [
  { id: 'gatewarden', label: 'BOSSES', title: 'Bring your whole machine.', text: 'Bosses test your damage, defenses and ability to react under pressure.' },
  { id: 'heavy-encounter', label: 'THREATS', title: 'Build an answer before it arrives.', text: 'Heavy targets, support units and splitting enemies punish one-dimensional builds.' },
  { id: 'artifact-choice', label: '16 ARTIFACTS', title: 'Change the rules of the run.', text: 'Boss rewards open new strategies instead of adding another small percentage.' },
  { id: 'build-paths', label: 'RESONANCE', title: 'Turn a strong weapon into a real plan.', text: 'Tier III mutations can reveal a related Market or Artifact opportunity. You still decide whether the combo is worth chasing.' },
  { id: 'hall-of-machines', label: 'RUN HISTORY', title: 'Every machine leaves a record.', text: 'Review your old builds, spot what failed and begin the next run with a different idea.' },
];
const latest = changelog[0];
const formatDate = (date: string) =>
  new Intl.DateTimeFormat('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .format(new Date(`${date}T00:00:00Z`));
---
<BaseLayout title="Spirebreak · Build your machine. Survive 30 waves." description="Choose the weapons, mutations, defenses and Artifacts that turn an automatic tower into your machine.">
  <section class="game-hero shell" aria-labelledby="game-title">
    <div class="hero-heading">
      <p class="game-hero-kicker">Single-player tower roguelite</p>
      <h1 id="game-title">Build your machine.<br /><span>Survive 30 escalating waves.</span></h1>
    </div>
    <figure class="hero-frame">
      <GameMedia asset={get('hero-combat')} eager sizes="(max-width: 820px) calc(100vw - 28px), (max-width: 1220px) 56vw, 660px" />
      <figcaption><span>REAL GAMEPLAY</span><span>A machine under pressure.</span></figcaption>
    </figure>
    <div class="hero-details">
      <p class="hero-copy">Combat is automatic. The build is yours. Spend Scrap on weapons, defenses and upgrades, mutate your strongest gear and decide which powerful combinations are worth pursuing.</p>
      <div class="hero-actions">
        <a class="button primary" href="#gameplay">See how a run changes ↓</a>
        <a class="button secondary" href="/changelog">Read the latest update</a>
      </div>
    </div>
  </section>

  <div class="run-facts shell" aria-label="Current game features">
    <span><strong>30</strong> escalating waves</span><span><strong>16</strong> run-changing Artifacts</span>
    <span>Branching weapon mutations</span><span>Bosses at waves 10, 20 and 30</span>
  </div>

  <section id="gameplay" class="section shell gameplay-gallery" aria-labelledby="gallery-title">
    <div class="section-heading">
      <span class="eyebrow">ONE RUN, MANY DIRECTIONS</span>
      <h2 id="gallery-title">Every purchase should change what you want next.</h2>
      <p>Stack weapons, cover weaknesses and decide when to commit to a risky combination.</p>
    </div>
    <div class="capture-grid">
      {gallery.map((item, index) => (
        <figure class:list={['capture-card', { 'capture-feature': index === 2 }]}>
          <a class="capture-link" href={get(item.id).src} aria-label={`Open full-size capture: ${get(item.id).caption}`}>
            <GameMedia asset={get(item.id)} sizes={index === 2 ? '(max-width: 820px) calc(100vw - 28px), (max-width: 1220px) 66vw, 775px' : '(max-width: 820px) calc(100vw - 28px), (max-width: 1220px) 48vw, 580px'} />
          </a>
          <figcaption>
            <span class="eyebrow">{item.label}</span><h3>{item.title}</h3><p>{item.text}</p>
            <a class="text-link" href={get(item.id).src}>Open screenshot ↗</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="portrait-section shell" aria-labelledby="portrait-title">
    <figure class="portrait-frame">
      <a href={get('portrait-boss').src} aria-label="Open full-size portrait gameplay">
        <GameMedia asset={get('portrait-boss')} sizes="(max-width: 480px) calc(100vw - 68px), 320px" />
      </a>
      <figcaption>Current gameplay · Portrait layout</figcaption>
    </figure>
    <div class="portrait-copy">
      <span class="eyebrow">DESKTOP AND PORTRAIT</span>
      <h2>The same run on either screen.</h2>
      <p>The arena and combat rules stay the same while the interface adapts around them.</p>
      <p class="muted">Android performance is still being tested on real devices.</p>
      <a class="text-link" href="/development">See what needs testing →</a>
    </div>
  </section>

  <section class="section shell development-footer" aria-labelledby="development-title">
    <div class="section-heading split-heading">
      <div><span class="eyebrow">LATEST UPDATE</span><h2 id="development-title">What changed for your next run?</h2></div>
      <a class="text-link" href="/changelog">Browse every update →</a>
    </div>
    <a class="latest-card" href={`/changelog/${latest.slug}`}>
      <time datetime={latest.date}>{formatDate(latest.date)}</time><h3>{latest.title}</h3><p>{latest.summary}</p><span class="text-link">Read the update →</span>
    </a>
    <div class="development-links">
      <a href="/roadmap">See what's next →</a><a href="/development">What we're testing →</a>
      <a href="/issues">Check known issues →</a><a href="/requests">Share an idea →</a>
    </div>
  </section>

  <section class="community-cta">
    <div class="shell community-grid">
      <div><span class="eyebrow">HELP SHAPE SPIREBREAK</span><h2>Tell us about the run you just had.</h2><p>Share the bug that stopped you, the choice that confused you or the build you want to try next.</p></div>
      <div class="community-actions"><a class="button primary" href={site.bugNew}>Report a bug</a><a class="button secondary" href={site.featureNew}>Share an idea</a></div>
    </div>
  </section>
</BaseLayout>
