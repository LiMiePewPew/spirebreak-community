---
import StatusPill from './StatusPill.astro';
interface Props {
  severity: 'high' | 'medium' | 'low';
  area: string;
  title: string;
  status: string;
  summary: string;
  href?: string;
}
const { severity, area, title, status, summary, href } = Astro.props;
const tone = severity === 'high' ? 'danger' : severity === 'medium' ? 'warning' : 'neutral';
---
<article class="issue-card">
  <div class="card-meta">
    <StatusPill text={`${severity.toUpperCase()} · ${area.toUpperCase()}`} tone={tone} />
    <span class="issue-status">{status}</span>
  </div>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p>{summary}</p>
</article>
