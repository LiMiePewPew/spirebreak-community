---
import type { GameMedia } from '@/data/media';

interface Props {
  media: GameMedia;
  class?: string;
  eager?: boolean;
}

const { media, class: className = '', eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : 'auto';
---

{media.kind === 'video' ? (
  <video
    class={className}
    width={media.width}
    height={media.height}
    poster={media.poster}
    autoplay
    muted
    loop
    playsinline
    preload={eager ? 'metadata' : 'none'}
    aria-label={media.alt}
  >
    <source src={media.src} />
  </video>
) : (
  <img
    class={className}
    src={media.src}
    width={media.width}
    height={media.height}
    alt={media.alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    style={media.focus ? `object-position:${media.focus}` : undefined}
  />
)}
