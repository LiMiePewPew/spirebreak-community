---
import type { GameMedia } from '@/data/media';
interface Props { asset: GameMedia; eager?: boolean; sizes?: string; }
const { asset, eager = false, sizes = '(max-width: 820px) calc(100vw - 28px), 580px' } = Astro.props;
const srcset = (variants: {src: string; width: number}[]) => variants.map(v => `${v.src} ${v.width}w`).join(', ');
---
{asset.kind === 'image' ? (
  <picture>
    {asset.avif.length > 0 && <source type="image/avif" srcset={srcset(asset.avif)} sizes={sizes} />}
    <img src={asset.src} srcset={srcset(asset.webp)} sizes={sizes}
      width={asset.width} height={asset.height} alt={asset.alt}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'}
      decoding="async" style={`aspect-ratio:${asset.aspectRatio};object-position:${asset.focus}`} />
  </picture>
) : (
  <video width={asset.width} height={asset.height} poster={asset.poster}
    autoplay muted loop playsinline controls preload="none" aria-label={asset.alt}
    style={`aspect-ratio:${asset.aspectRatio}`} data-game-loop>
    <source src={asset.src} type="video/webm" />
    {asset.mp4 && <source src={asset.mp4} type="video/mp4" />}
    <a href={asset.src}>Watch gameplay: {asset.caption}</a>
  </video>
)}
<script>
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const update = () => document.querySelectorAll<HTMLVideoElement>('[data-game-loop]').forEach(video => {
    video.muted = true;
    if (preference.matches) { video.autoplay = false; video.pause(); }
  });
  update();
  preference.addEventListener('change', update);
</script>
<style>
  picture { display: block; }
  img, video { display: block; width: 100%; height: auto; background: #091116; }
</style>
