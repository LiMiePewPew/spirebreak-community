---
const path = Astro.url.pathname;
const nav = [
  ['/game', 'The game'],
  ['/changelog', 'Updates'],
  ['/roadmap', 'Roadmap'],
  ['/development', 'Playtest'],
];
---
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="Spirebreak home">
      <img class="brand-icon" src="/media/brand/spirebreak-mark.png" alt="" width="96" height="96" />
      <img class="brand-wordmark" src="/media/brand/spirebreak-wordmark.webp" alt="" width="1019" height="79" />
    </a>
    <nav aria-label="Primary navigation">
      {nav.map(([href, label]) => <a href={href} aria-current={path === href || path.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
